<IfModule mod_rewrite.c>
  RewriteEngine On
  # Teruskan header Authorization ke PHP (Apache menghapusnya secara default)
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
  # Frontend SPA (Vite build di frontend/dist) — lewati file statis & /api
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # API -> front controller
  RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Accept"
</IfModule>
